    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.evaluarPaciente ){",
        "\treturn {",
        "\t\t//map evaluarPaciente variable to expected task contract input",
        "\t\tevaluarPacienteInput: {",
        "\t\t\tsintomas: $data.evaluarPaciente.sintomas !== undefined ? $data.evaluarPaciente.sintomas : null,",
        "\t\t\tdescripcion: $data.evaluarPaciente.descripcion !== undefined ? $data.evaluarPaciente.descripcion : null,",
        "\t\t\tenfermedadSospecha: $data.evaluarPaciente.enfermedadSospecha !== undefined ? $data.evaluarPaciente.enfermedadSospecha : null,",
        "\t\t\tmedicamentos: $data.evaluarPaciente.medicamentos !== undefined ? $data.evaluarPaciente.medicamentos : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
