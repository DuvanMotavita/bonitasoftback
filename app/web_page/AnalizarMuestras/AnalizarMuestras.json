    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.analizarMuestras ){",
        "\treturn {",
        "\t\t//map analizarMuestras variable to expected task contract input",
        "\t\tanalizarMuestrasInput: {",
        "\t\t\tid: $data.analizarMuestras.id !== undefined ? $data.analizarMuestras.id : null,",
        "\t\t\tnombre: $data.analizarMuestras.nombre !== undefined ? $data.analizarMuestras.nombre : null,",
        "\t\t\tconsistencia: $data.analizarMuestras.consistencia !== undefined ? $data.analizarMuestras.consistencia : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "analizarMuestras" : {
