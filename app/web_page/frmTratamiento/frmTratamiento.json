  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.tratamiento ){",
        "\treturn {",
        "\t\t//map tratamiento variable to expected task contract input",
        "\t\ttratamientoInput: {",
        "\t\t\tid: $data.tratamiento.id !== undefined ? $data.tratamiento.id : null,",
        "\t\t\tnombreTratamiento: $data.tratamiento.nombreTratamiento !== undefined ? $data.tratamiento.nombreTratamiento : null,",
        "\t\t\tnumeroDias: $data.tratamiento.numeroDias !== undefined ? $data.tratamiento.numeroDias : null,",
        "\t\t\tresultadoFinal: $data.tratamiento.resultadoFinal !== undefined ? $data.tratamiento.resultadoFinal : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "tratamiento" : {
      "type" : "url",
      "value" : [
        "../{{context.tratamiento_ref.link}}"
      ],
      "exposed" : false
    }
