    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.registrarCirugia ){",
        "\treturn {",
        "\t\t//map registrarCirugia variable to expected task contract input",
        "\t\tregistrarCirugiaInput: {",
        "\t\t\tnombreCirujano: $data.registrarCirugia.nombreCirujano !== undefined ? $data.registrarCirugia.nombreCirujano : null,",
        "\t\t\tcedulaPaciente: $data.registrarCirugia.cedulaPaciente !== undefined ? $data.registrarCirugia.cedulaPaciente : null,",
        "\t\t\tnombreCirugia: $data.registrarCirugia.nombreCirugia !== undefined ? $data.registrarCirugia.nombreCirugia : null,",
        "\t\t\tfechaCirugia: $data.registrarCirugia.fechaCirugia !== undefined ? $data.registrarCirugia.fechaCirugia : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
