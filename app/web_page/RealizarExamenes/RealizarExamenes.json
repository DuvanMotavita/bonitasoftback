    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.realizarExamenes ){",
        "\treturn {",
        "\t\t//map realizarExamenes variable to expected task contract input",
        "\t\trealizarExamenesInput: {",
        "\t\t\tid: $data.realizarExamenes.id !== undefined ? $data.realizarExamenes.id : null,",
        "\t\t\tnombreProcedimiento: $data.realizarExamenes.nombreProcedimiento !== undefined ? $data.realizarExamenes.nombreProcedimiento : null,",
        "\t\t\tresultados: $data.realizarExamenes.resultados !== undefined ? $data.realizarExamenes.resultados : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "realizarExamenes" : {
