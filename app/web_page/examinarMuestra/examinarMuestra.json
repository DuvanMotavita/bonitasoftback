      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.examinarMuestras ){",
        "\treturn {",
        "\t\t//map examinarMuestras variable to expected task contract input",
        "\t\texaminarMuestrasInput: {",
        "\t\t\tnombreProcedimiento: $data.examinarMuestras.nombreProcedimiento !== undefined ? $data.examinarMuestras.nombreProcedimiento : null,",
        "\t\t\tresultados: $data.examinarMuestras.resultados !== undefined ? $data.examinarMuestras.resultados : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
